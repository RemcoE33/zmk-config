#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        alfred: alfred {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "ALFRED";
        };

        snippits: snippits {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(SPACE))>;
            label = "SNIPPITS";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(Z))>;
            label = "SCREENSHOT";
        };

        raycast: raycast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE)>;
            label = "RAYCAST";
        };

        shortcat: warp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(SPACE))>;
            label = "WARP";
        };

        GoVariable: GoVariable {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp EQUAL>;
            label = "GOVARIABLE";
        };

        tmux: tmux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B)>;
            label = "TMUX";
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(LA(RIGHT_GUI)))>;
            label = "HYPER";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp LCTRL       &kp Q  &kp W  &kp E  &kp R        &kp T               &kp Y         &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp TAB         &kp A  &kp S  &kp D  &kp F        &kp G               &kp H         &kp J      &kp K      &kp L    &kp SEMI  &mt LS(LA(LC(LEFT_GUI))) SQT
&sk LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V        &kp B               &kp N         &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp LEFT_SHIFT
                              &mo 1  &lt 3 SPACE  &kp LEFT_COMMAND    &kp LEFT_ALT  &kp ENTER  &mo 2
            >;
        };

        symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE    &kp EXCL      &kp AT        &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS          &kp KP_MULTIPLY  &kp LPAR           &kp RPAR       &kp PIPE
&trans        &trans        &trans        &kp EQUAL  &kp PLUS  &trans       &kp MINUS  &kp LESS_THAN     &kp LEFT_BRACE   &kp LEFT_BRACKET   &GoVariable    &kp GRAVE
&out OUT_TOG  &bt BT_SEL 1  &bt BT_SEL 0  &trans     &trans    &trans       &kp UNDER  &kp GREATER_THAN  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp TILDE
                                          &trans     &trans    &trans       &trans     &trans            &trans
            >;
        };

        num_macro {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE  &kp N1   &kp N2       &kp N3     &kp N4   &kp N5    &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&trans      &alfred  &snippits    &raycast   &kp F2   &kp F4    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans      &none    &screenshot  &shortcat  &kp F12  &tmux     &trans    &trans    &trans  &trans     &trans  &trans
                                  &trans     &trans   &trans    &trans    &trans    &trans
            >;
        };

        excel_window {
            bindings = <
&trans  &trans  &trans  &trans            &trans            &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &none   &none   &kp LEFT_SHIFT    &kp LEFT_COMMAND  &none     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &kp LC(LEFT_ALT)  &trans            &trans    &trans          &trans          &trans        &trans           &trans  &trans
                        &trans            &trans            &trans    &trans          &trans          &trans
            >;
        };
    };
};
